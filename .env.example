# Copia este archivo a `.env.local` y rellena los valores.
# Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server-side (Edge Functions / route handlers). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Super-admins de plataforma (lista separada por comas). Solo ellos pueden
# registrar el marcador real de los partidos en /admin. Server-side.
SUPERADMIN_EMAILS=tu-correo@ejemplo.com

# URL canónica del sitio. Se usa en los redirectTo de Supabase (OAuth, magic
# link, recuperación) y en los links de invitación a grupos. EN PRODUCCIÓN
# debe ser https://pollota.com — si queda en localhost, tanto los enlaces de
# acceso como las invitaciones llegarán rotos. Debe coincidir con los Redirect
# URLs permitidos en Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID). Genera el par con: `npx web-push generate-vapid-keys`.
# La pública se expone al cliente; la privada y el subject son solo server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
